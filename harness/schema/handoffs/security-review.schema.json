{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "producer",
    "status",
    "trust_boundaries",
    "findings",
    "residual_risks",
    "evidence_refs"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "producer": {
      "const": "security-reviewer"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INSUFFICIENT"
      ]
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "claim",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scenario": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
