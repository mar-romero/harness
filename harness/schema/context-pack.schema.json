{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditable file context pack",
  "type": "object",
  "required": ["task_id", "policy_version", "route", "files", "memory", "graph_neighbors", "graph_backend", "total_bytes", "estimated_tokens", "limits"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "policy_version": {"enum": [2, 3]},
    "route": {"type": "object"},
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "estimated_tokens", "sha256", "score", "reason"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "bytes": {"type": "integer", "minimum": 0},
          "estimated_tokens": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "score": {"type": "integer", "minimum": 1, "maximum": 1000},
          "reason": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"type": "string", "pattern": "^(?:policy|explicit|dependency-graph-neighbor|related-test|memory|path-token:[a-z0-9_-]+(?:,[a-z0-9_-]+){0,4})$"}}
        },
        "additionalProperties": false
      }
    },
    "memory": {"type": "array"},
    "graph_neighbors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "graph_backend": {
      "type": "object",
      "required": ["requested", "selected", "fallback_reason"],
      "properties": {
        "requested": {"enum": ["auto", "lexical", "codegraph"]},
        "selected": {"enum": ["lexical", "codegraph"]},
        "fallback_reason": {"enum": [null, "unavailable", "backend_error", "invalid_output"]}
      },
      "additionalProperties": false
    },
    "total_bytes": {"type": "integer", "minimum": 0},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "limits": {
      "type": "object",
      "required": ["files", "bytes", "estimated_tokens"],
      "properties": {
        "files": {"type": "integer", "minimum": 0, "maximum": 10000},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 64000000},
        "estimated_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff])[^/]+(?:/[^/]+)*$"
    }
  },
  "additionalProperties": true
}
