{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness benchmark suite",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
