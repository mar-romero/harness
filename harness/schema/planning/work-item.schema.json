{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-harness.local/schema/planning/work-item.schema.json",
  "title": "Planning work item",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "type": {
      "enum": [
        "PROJECT",
        "EPIC",
        "FEATURE",
        "SPIKE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "active",
        "done",
        "deferred"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
