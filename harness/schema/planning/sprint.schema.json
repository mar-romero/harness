{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-harness.local/schema/planning/sprint.schema.json",
  "title": "Harness sprint / bounded execution batch",
  "type": "object",
  "required": [
    "id",
    "goal",
    "capacity_units",
    "task_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "capacity_units": {
      "type": "integer",
      "minimum": 1
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
