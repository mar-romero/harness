{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness evolution evaluation run",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "snapshot_sha256", "deterministic", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "label": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deterministic": {
      "type": "object",
      "required": ["unit_tests", "evals"],
      "properties": {
        "unit_tests": {"$ref": "#/$defs/check"},
        "evals": {"$ref": "#/$defs/check"}
      }
    },
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["returncode", "duration_seconds"],
      "properties": {
        "returncode": {"type": "integer"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "output": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
